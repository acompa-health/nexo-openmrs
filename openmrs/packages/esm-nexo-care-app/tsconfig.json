{
  "compilerOptions": {
    "esModuleInterop": true,
    "module": "esnext",
    "allowSyntheticDefaultImports": true,
    "jsx": "react",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "lib": ["dom", "es2022", "es2023"],
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "target": "esnext",
    "strict": true,
    "types": ["fhir", "webpack-env", "node"]
  },
  "include": ["src"]
}
